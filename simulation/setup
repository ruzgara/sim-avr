#!/usr/bin/env bash
# simulation/setup - one-time setup for a project using this simulation kit.
#
#   ./simulation/setup
#
# 1. Checks the tools the kit needs and offers to install any that are missing (brew / apt).
# 2. Creates the project's Makefile, a starter .s file, wokwi.toml and .gitignore if they don't exist.
# 3. Builds the simulator launcher.
#
# Safe to run again at any time: it never overwrites existing files.
set -euo pipefail

SIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SIM_DIR")"
NAME="$(basename "$PROJECT_DIR")"

bold()  { printf '\033[1m%s\033[0m\n' "$*"; }
ok()    { printf '  \033[32mok\033[0m       %s\n' "$*"; }
miss()  { printf '  \033[31mmissing\033[0m  %s\n' "$*"; }
note()  { printf '  %s\n' "$*"; }

ask() {   # ask "question" -> returns 0 for yes
    local reply
    read -r -p "$1 [y/N] " reply
    [[ "$reply" =~ ^[Yy] ]]
}

# ---------------------------------------------------------------- 1. dependencies

case "$(uname)" in
    Darwin) PLATFORM=mac ;;
    Linux)  if command -v apt-get >/dev/null; then PLATFORM=apt; else PLATFORM=other; fi ;;
    *)      PLATFORM=other ;;
esac

missing_pkgs=()

# check "description" "test command" "brew package" "apt package"   ("-" = no package to install)
check() {
    local desc="$1" test="$2" brew_pkg="$3" apt_pkg="$4" pkg
    if bash -c "$test" >/dev/null 2>&1; then
        ok "$desc"
        return
    fi
    miss "$desc"
    case "$PLATFORM" in
        mac) pkg="$brew_pkg" ;;
        apt) pkg="$apt_pkg" ;;
        *)   pkg="-" ;;
    esac
    if [[ "$pkg" != "-" ]]; then
        missing_pkgs+=("$pkg")
    fi
}

bold "Checking dependencies ($PLATFORM)"
check "avr assembler (avr-as)"           "command -v avr-as"                            osx-cross/avr/avr-gcc binutils-avr
check "avr linker (avr-ld, avr-objcopy)" "command -v avr-ld && command -v avr-objcopy"  osx-cross/avr/avr-gcc binutils-avr
check "avr-gdb"                          "command -v avr-gdb"                           osx-cross/avr/avr-gdb gdb-avr
check "simavr library + headers"         "pkg-config --exists simavr"                   osx-cross/avr/simavr  libsimavr-dev
check "libelf"                           "pkg-config --exists libelf"                   libelf                libelf-dev
check "C compiler (cc)"                  "command -v cc"                                -                     build-essential
check "make"                             "command -v make"                              -                     make
check "pkg-config"                       "command -v pkg-config"                        pkgconf               pkg-config
check "tmux"                             "command -v tmux"                              tmux                  tmux
check "ttyd (terminal in the browser)"   "command -v ttyd"                              ttyd                  ttyd
check "python3"                          "command -v python3"                           python3               python3

if [[ "$PLATFORM" == mac ]] && ! command -v cc >/dev/null; then
    echo "  The C compiler and make come with Apple's command line tools: xcode-select --install"
fi

if ((${#missing_pkgs[@]})); then
    # Remove duplicates, keep order
    read -r -a missing_pkgs <<< "$(printf '%s\n' "${missing_pkgs[@]}" | awk '!seen[$0]++' | tr '\n' ' ')"
    echo
    case "$PLATFORM" in
        mac)
            if ! command -v brew >/dev/null; then
                echo "Homebrew is needed to install these: https://brew.sh"
                exit 1
            fi
            cmd=(brew install "${missing_pkgs[@]}")
            ;;
        apt)
            cmd=(sudo apt-get install -y "${missing_pkgs[@]}")
            ;;
        *)
            echo "Unsupported platform: install the missing tools above manually, then run this again."
            exit 1
            ;;
    esac
    echo "To install the missing tools this will run:"
    note "${cmd[*]}"
    if ask "Install now?"; then
        [[ "$PLATFORM" == apt ]] && sudo apt-get update
        "${cmd[@]}"
    else
        echo "Skipped. Install them yourself, then run ./simulation/setup again."
        exit 1
    fi
fi

# Optional: avrdude, only needed for `make upload` to a real board
if ! command -v avrdude >/dev/null; then
    echo
    echo "Optional: avrdude is not installed. It is only needed to upload to a real Nano (make upload)."
    case "$PLATFORM" in
        mac) opt_cmd=(brew install avrdude) ;;
        apt) opt_cmd=(sudo apt-get install -y avrdude) ;;
        *)   opt_cmd=() ;;
    esac
    if ((${#opt_cmd[@]})) && ask "Install avrdude now (${opt_cmd[*]})?"; then
        "${opt_cmd[@]}"
    fi
fi

# gdb's Python TUI windows (the I/O pane) need gdb 10 or newer with Python
GDB="$(command -v avr-gdb)"
if ! "$GDB" -batch -ex 'python import gdb; assert hasattr(gdb, "register_window_type")' >/dev/null 2>&1; then
    echo
    echo "warning: $GDB has no Python TUI support (needs gdb >= 10 with Python)."
    echo "         Debugging works, but the I/O register pane (layout avr) won't."
fi

# ---------------------------------------------------------------- 2. project files

echo
bold "Setting up project '$NAME' in $PROJECT_DIR"
cd "$PROJECT_DIR"

if [[ -e Makefile ]]; then
    note "Makefile exists, leaving it"
    if ! grep -q 'simulation/avr.mk' Makefile; then
        note "  note: it doesn't include simulation/avr.mk, so make run/upload won't work yet. Either:"
        note "    - mv Makefile Makefile.old and run ./simulation/setup again, or"
        note "    - add these lines to it:  NAME := $NAME   and   include simulation/avr.mk"
    fi
else
    printf 'NAME := %s\ninclude simulation/avr.mk\n' "$NAME" > Makefile
    note "created Makefile"
fi

if compgen -G '*.s' >/dev/null; then
    note "assembly source exists, leaving it"
else
    cat > "$NAME.s" <<'EOF'
; Starter program: blinks the LEDs on D8-D11 (PB0-PB3) about once a second.

.equ SREG,  0x3f
.equ DDRB,  0x04
.equ PORTB, 0x05

.org 0

main:
    ldi r16, 0
    out SREG, r16           ; clear the status register
    ldi r16, 0b00001111
    out DDRB, r16           ; PB0-PB3 are outputs

mainloop:
    ldi r16, 0b00001111
    out PORTB, r16          ; LEDs on
    rcall delay
    ldi r16, 0
    out PORTB, r16          ; LEDs off
    rcall delay
    rjmp mainloop

delay:                      ; about 0.5 s at 16 MHz (40 x 256 x 256 loop iterations)
    ldi r20, 40
1:  clr r19
2:  clr r18
3:  dec r18
    brne 3b
    dec r19
    brne 2b
    dec r20
    brne 1b
    ret
EOF
    note "created $NAME.s"
fi

if [[ -e simulation/wokwi.toml ]]; then
    note "simulation/wokwi.toml exists, leaving it"
else
    cat > simulation/wokwi.toml <<EOF
# Only used by the official Wokwi VS Code extension (F1 > "Wokwi: Select Config File").
# The kit's own viewer (make run / make view) does not need this file.
[wokwi]
version = 1
firmware = '../$NAME.hex'
elf = 'build/$NAME.elf'
EOF
    note "created simulation/wokwi.toml"
fi

if ! grep -qx 'simulation/build/' .gitignore 2>/dev/null; then
    echo 'simulation/build/' >> .gitignore
    note "added simulation/build/ to .gitignore"
fi

chmod +x simulation/run.sh simulation/setup simulation/upload.sh

# ---------------------------------------------------------------- 3. launcher

echo
bold "Building the simulator launcher"
make --no-print-directory -f simulation/avr.mk NAME="$NAME" launcher

echo
bold "Done."
echo "  make        build $NAME.hex"
echo "  make run    simulator + gdb + circuit viewer"
echo "  make sim    simulator + gdb"
echo "  make view   circuit viewer only (program runs freely)"
echo "  make upload upload to a real Nano (BOOTLOADER=new for the 115200 baud bootloader)"
